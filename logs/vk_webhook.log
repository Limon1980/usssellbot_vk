0x1080,1280x1280&from=bu"}],"text":"","user_id":100,"web_view_token":"9fbed3800e16538983","has_tags":false,"orig_photo":{"height":1280,"type":"base","url":"https:\/\/sun9-8.userapi.com\/s\/v1\/ig2\/x8An7eQCCIT8yFaaYuRR-Dc7CHwFxbjftU46fZBpCHfy1hXobPrWfjh_8g9g6kXWG1x3a-hwucSRvkxIGkITdvtY.jpg?quality=96&as=32x32,48x48,72x72,108x108,160x160,240x240,360x360,480x480,540x540,640x640,720x720,1080x1080,1280x1280&from=bu","width":1280}},"style":"full"}],"attachments_meta":{"primary_mode":"single","carousel_ratio":1.000000,"ratio":1.000000},"date":1780442223,"from_id":-238306571,"header":{"photo":{"source_id":-238306571},"title":{"source_id":-238306571},"descriptions":[]},"id":153,"is_archived":false,"reaction_set_id":"reactions","owner_id":-238306571,"post_type":"post","text":"Всем доброго утра и хорошего настроения! Сегодня среда - день стольника для хвостиков \"Открой своё сердце\".\n\nВ большой семье всегда много планов и немало сложностей, но самое важное всегда - накормить всех жителей нашего приюта! Это каждодневная забота дается нелегко, особенно,  когда организация благотворительная!\n\nВаша поддержка даёт нам возможность выстоять и помочь тем, кто оказался в беде, дать временный или  постоянный кров и опеку, а счастливчикам дождаться своих самых лучших хозяев и обрести свой дом. \n\nЕсли вы можете и хотите помочь, присоединяйтесь! Важна любая помощь: финансовая, кормами, лекарствами, физическая и др. \n\nРеквизиты для помощи:\n1. QR - код на фото\n2. По банковским реквизитам\nсчет\nТел: +75500000023\n2313\nИНН 2511105720\nБанк ДАЛЬНЕВОСТОЧНЫЙ БАНК ПАО СБЕРБАНК\nБИК 040813608\nК\/с 30101810600000000608\nКПП 251101001\nНаименование организации:\nОО ПК \"ПОМОЩЬ БЕЗДОМНЫМ ЖИВОТНЫМ \"ОТКРОЙ СВОЕ СЕРДЦЕ\"\n3. По номеру: т. 89089667747"},"secret":"TRargo121980"}
