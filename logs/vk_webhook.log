092&from=bu"}],"text":"","user_id":100,"web_view_token":"0f81a52b10c566913c","has_tags":false,"orig_photo":{"height":1092,"type":"base","url":"https:\/\/sun9-22.userapi.com\/s\/v1\/ig2\/ZjsgBmkKqau1bJSqNAB1Se10clhjDjnGkeeFpNULYi4G8lHV9KHGAJdKljusgGWg3L1OB_Rk8FL1t1mzxu1r7YUf.jpg?quality=96&as=32x27,48x41,72x61,108x92,160x136,240x205,360x307,480x409,540x461,640x546,720x614,1080x921,1280x1092&from=bu","width":1280}},"style":"full"}],"attachments_meta":{"primary_mode":"single","carousel_ratio":1.180000,"ratio":1.180000},"date":1781500623,"from_id":-238306571,"header":{"photo":{"source_id":-238306571},"title":{"source_id":-238306571},"descriptions":[]},"id":206,"is_archived":false,"reaction_set_id":"reactions","owner_id":-238306571,"post_type":"post","text":"‼️Уссурийск‼️Ищем добрые руки для кошечки . Кошечка стерилизована, здорова, возраст примерно 4 года, к лотку приучена. Малышка жила на улице, пережила суровую зиму, а это подвал, холод, одиночество. Заботились о ней, как могли, кормили, оберегали. После зимы свозили в клинику, привели в порядок свалявшуюся шерсть, потравили паразитов , сдали анализы. Сейчас кошечка находится на передержке , готовится к прививке. У кошечки свой характер, она не принимает конкуренции, отстаивает территорию от сородичей. Очень нужен добрый, терпеливый человек , кто смог бы подарить дом, тепло и заботу этой пушистой  красавице, и для кого она станет единственным и самым любимым питомцем. Кошечка очень осторожная , но бесконечно благодарна тем, кто кормит и за ней ухаживает. Телеграм, what’s up , max\nТел: \nТел: \nТел: +79644468525"},"secret":"TRargo121980"}
